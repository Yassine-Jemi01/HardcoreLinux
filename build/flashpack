#!/bin/bash

cd "$1" || exit 1

installer=$(find etc/installer -mindepth 1 -maxdepth 1 -type d -print -quit)
if [ -z "$installer" ]; then
	echo "flashpack: no installer directory found" >&2
	exit 1
fi

if [ ! -f "$installer/install" ]; then
	printf '%s\n' '#!/bin/sh' 'exit 0' > "$installer/install"
	chmod 0711 "$installer/install"
fi

touch "$installer/uninstall"
printf '%s' "$(for i in $(find -type f,l); do echo "rm ${i:1}"; done)" >> "$installer/uninstall"
printf '\n\n' >> "$installer/uninstall"
printf '%s' "$(for i in $(find -type d); do echo "rmdir ${i:1}"; done)" >> "$installer/uninstall"

tar -cpz $(ls) -f "$(basename "$installer").tar"
