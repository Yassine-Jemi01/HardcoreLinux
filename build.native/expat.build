

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr  --with-dev-urandom --without-examples --without-tests
make -j$(nproc)
make DESTDIR=/tmp/stage install
find /tmp/stage -name *.so -exec strip --strip-all {} \;
find /tmp/stage -name *.la -exec rm {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/expat.yspkg" --name "expat" --version "2.8.2" --abi yspm-abi-1 --arch x86_64
