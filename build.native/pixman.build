

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr -Dopenmp=disabled -Dloongson-mmi=disabled --reconfigure
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/pixman.yspkg" --name "pixman" --version "0.46.4" --abi yspm-abi-1 --arch x86_64
