#!/bin/sh

#
# download at https://github.com/dosfstools/dosfstools/releases/download/v4.2/dosfstools-4.2.tar.gz
#

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install
rm /tmp/stage
rm -r /tmp/stage/usr/share
cd $wd
yspm build --root /tmp/stage --output "$wd/dosfstools.yspkg" --name "dosfstools" --version "4.2" --abi yspm-abi-1 --arch x86_64 --depends "musl"
