

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr -Dtests=false --reconfigure
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
rm -rf /tmp/stage/usr/share/man
rm -rf /tmp/stage/usr/share/info
rm -rf /tmp/stage/usr/share/doc
cd $wd
yspm build --root /tmp/stage --output "$wd/glib.yspkg" --name "glib" --version "2.89.3" --abi yspm-abi-1 --arch x86_64
