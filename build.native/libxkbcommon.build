

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. -Dprefix=/usr -Denable-x11=false -Denable-docs=false  -Ddefault-layout=us --reconfigure
cp $wd/yacc-wrapper ../scripts/yacc-wrapper
ninja
meson install --destdir=/tmp/stage > /dev/null
find /tmp/stage -name '*.so' -exec strip --strip-all {} \;
find /tmp/stage -name '*.la' -exec rm {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libxkbcommon.yspkg" --name "libxkbcommon" --version "1.14.0-beta" --abi yspm-abi-1 --arch x86_64 --depends "zlib,libffi,libwayland,wayland-protocols"
