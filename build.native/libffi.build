

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr --enable-static=no
make -j$(nproc)
make DESTDIR=/tmp/stage install
find /tmp/stage -name *.so -exec strip --strip-all {} \;
find /tmp/stage -name *.la -exec rm {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libffi.yspkg" --name "libffi" --version "3.7.1" --abi yspm-abi-1 --arch x86_64
