#!/bin/sh

## must be built on Alpine or Hardcore

echo $dir
wd=$(pwd)
cd $dir
mkdir -p /tmp/stage/usr/bin/
gcc -Os sudo.c -o /tmp/stage/usr/bin/sudo
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
yspm build --root /tmp/stage --output "$wd/sudo.yspkg" --name "sudo" --version "0.0.1" --abi yspm-abi-1 --arch x86_64 --depends "musl"
