

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --reconfigure -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libdrm.yspkg" --name "libdrm" --version "2.134.0" --abi yspm-abi-1 --arch x86_64 --depends "musl,zlib,libpciaccess"
