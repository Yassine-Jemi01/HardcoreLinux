#!/bin/sh
wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson .. --prefix=/usr --wipe -Dc_link_args="-Wl,-rpath-link,src/GLdispatch"
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libglvnd.yspkg" --name "libglvnd" --version "1.7.0" --abi yspm-abi-1 --arch x86_64
