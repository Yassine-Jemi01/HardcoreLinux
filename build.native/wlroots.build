#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup .. --prefix=/usr --wipe --reconfigure -Dbackends=libinput,drm
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/wlroots.yspkg" --name "wlroots" --version "0.20.0" --abi yspm-abi-1 --arch x86_64 --depends "musl,libevdev,udev,libinput,libwayland,libdrm"
