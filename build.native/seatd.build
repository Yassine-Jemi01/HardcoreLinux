#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/seatd.yspkg" --name "seatd" --version "0.9.3" --abi yspm-abi-1 --arch x86_64
