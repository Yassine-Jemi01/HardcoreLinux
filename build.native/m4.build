

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install
rm -r /tmp/stage/usr/share
find /tmp/stage -name *.so -exec strip --strip-all {} \;
find /tmp/stage -name *.la -exec rm {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/m4.yspkg" --name "m4" --version "1.4.21" --abi yspm-abi-1 --arch x86_64
