#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -r build
mkdir build
cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libdisplay-info.yspkg" --name "libdisplay-info" --version "0.0.0" --abi yspm-abi-1 --arch x86_64
