#!/bin/sh

echo $dir
wd=$(pwd)
cd $dir
rm -r /tmp/stage
./configure CC="gcc --sysroot=/" --prefix=/usr
make  SHELL=/bin/sh -j$(nproc)
make SHELL=/bin/sh DESTDIR=/tmp/stage install -j2
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
rm -r /tmp/stage/usr/share
cd $wd
yspm build --root /tmp/stage --output "$wd/dropbear.yspkg" --name "dropbear" --version "2026.94" --abi yspm-abi-1 --arch x86_64 --depends "openssl,zlib"
