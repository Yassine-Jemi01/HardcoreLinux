

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. -Dprefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage

find /tmp/stage -name *.so -exec strip --strip-all {} \;

cd $wd
yspm build --root /tmp/stage --output "$wd/libcairo_png.yspkg" --name "libcairo_png" --version "1.18.4" --abi yspm-abi-1 --arch x86_64 --depends "musl,zlib,pixman"
