

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup --reconfigure -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libpciaccess.yspkg" --name "libpciaccess" --version "0.11.1" --abi yspm-abi-1 --arch x86_64 --depends "musl,zlib"
