#!/bin/sh

set -eu

wd=$(pwd)
src=/tmp/yspm-build
stage=/tmp/stage

go_bin=/usr/local/go/bin/go
if [ ! -x "$go_bin" ]; then
    go_bin=$(command -v go || true)
fi
if [ -z "$go_bin" ] || [ ! -x "$go_bin" ]; then
    echo "yspm.build: Go 1.27.1 is required (install the go package first)" >&2
    exit 1
fi

rm -rf "$src" "$stage"
git clone --depth 1 https://github.com/Yassine-Jemi01/yspm.git "$src"
cd "$src"
git fetch --depth 1 origin 81d06bc1bfdf83053e3ab1b31585f7de8af5f941
git checkout --detach 81d06bc1bfdf83053e3ab1b31585f7de8af5f941

mkdir -p "$stage/usr/bin"

CGO_ENABLED=0 GOTOOLCHAIN=local "$go_bin" build \
    -trimpath \
    -buildvcs=false \
    -ldflags='-s -w' \
    -o "$stage/usr/bin/yspm" \
    ./cmd/yspm

chmod 0755 "$stage/usr/bin/yspm"

cd "$wd"
"$stage/usr/bin/yspm" build --root "$stage" --output "$wd/yspm.yspkg" --name "yspm" --version "0.2.0" --abi yspm-abi-1 --arch x86_64

rm -rf "$src"
