#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup --prefix=/usr -Dexamples=false -Dtests=false --wipe
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name '*.so*' -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/fuse.yspkg" --name "fuse" --version "3.18.2" --abi yspm-abi-1 --arch x86_64
