

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. -Ddocumentation=false -Dprefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libwayland.yspkg" --name "libwayland" --version "1.26.0" --abi yspm-abi-1 --arch x86_64 --depends "zlib,libpciaccess,libdrm,libffi"
