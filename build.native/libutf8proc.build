#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
cmake  .. -DBUILD_SHARED_LIBS=ON -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib
make -j$(nproc)
make DESTDIR=/tmp/stage install
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/libutf8proc.yspkg" --name "libutf8proc" --version "2.11.3" --abi yspm-abi-1 --arch x86_64
