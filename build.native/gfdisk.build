#!/bin/sh

echo $dir
wd=$(pwd)
cd $dir
rm -r /tmp/stage
CXX="g++ --sysroot=/" LDFLAGS=-ltinfo make -j$(nproc)
cp cgdisk gdisk /tmp/stage/usr/sbin
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
yspm build --root /tmp/stage --output "$wd/gfdisk.yspkg" --name "gfdisk" --version "?" --abi yspm-abi-1 --arch x86_64 --depends "musl,deve2fsprogs,popt"
