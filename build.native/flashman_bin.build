#!/bin/sh

## must be built on Alpine or Hardcore

echo $dir
wd=$(pwd)
cd $dir
gcc -O3 flashman.c -o /tmp/stage/usr/bin/flashmanbin
for file in $(find /tmp/stage -type f); do if [ -x $file ]; then strip $file; fi; done
cd $wd
yspm build --root /tmp/stage --output "$wd/flashman-bin.yspkg" --name "flashman-bin" --version "0.0.2" --abi yspm-abi-1 --arch x86_64 --depends "busybox,musl"
