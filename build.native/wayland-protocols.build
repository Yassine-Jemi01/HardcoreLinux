

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --reconfigure -Dtests=false -Dprefix=/usr
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/wayland-protocols.yspkg" --name "wayland-protocols" --version "1.41" --abi yspm-abi-1 --arch x86_64
