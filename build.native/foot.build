#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup --prefix=/usr -Dtests=false --wipe
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name '*.so*' -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/foot.yspkg" --name "foot" --version "???" --abi yspm-abi-1 --arch x86_64 --depends "tllist,libwayland,fontconfig,fcft"
