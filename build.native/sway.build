#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir build
cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
find /tmp/stage -name *.so -exec strip --strip-all {} \;

scripts=/tmp/yspm-scripts/sway
rm -rf "$scripts"
mkdir -p "$scripts"
cat > "$scripts/postinstall" <<'POSTINSTALL'
#!/bin/sh
root=${YSPM_ROOT:-/}
mv "$root/usr/bin/sway" "$root/usr/bin/sway.bin"
cat > "$root/usr/bin/sway" <<'WRAPPER'
#!/bin/sh
export WLR_RENDERER=pixman
exec /usr/bin/sway.bin "$@"
WRAPPER
chmod 0755 "$root/usr/bin/sway"
POSTINSTALL
chmod 0755 "$scripts/postinstall"

cd "$wd"
yspm build --root /tmp/stage --output "$wd/sway.yspkg" --name "sway" --version "1.12" --abi yspm-abi-1 --arch x86_64 --depends "wlroots,pango,udev" --scripts "$scripts"
rm -rf "$scripts"
