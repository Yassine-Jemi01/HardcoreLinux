#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
./configure --prefix=/usr
make -j$(nproc)
make DESTDIR=/tmp/stage install
rm -r /tmp/stage/usr/share/info
rm -r /tmp/stage/usr/share/man
cd $wd
yspm build --root /tmp/stage --output "$wd/autotools.yspkg" --name "autotools" --version "2.73" --abi yspm-abi-1 --arch x86_64 --depends "m4"
