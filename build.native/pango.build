

#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure --buildtype=release -Dintrospection=disabled -Dgtk_doc=false -Dc_link_args="-Wl,-rpath-link,pango"
ninja
meson install --destdir=/tmp/stage

find /tmp/stage -name *.so -exec strip --strip-all {} \;

cd $wd
yspm build --root /tmp/stage --output "$wd/pango.yspkg" --name "pango" --version "1.58.2" --abi yspm-abi-1 --arch x86_64 --depends "zlib,pixman,libcairo_png,glib,fribidi,fontconfig,expat,libffi"
