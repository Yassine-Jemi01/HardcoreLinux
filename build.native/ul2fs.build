#!/bin/sh

#
# download at my github!
#

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
mkdir -p /tmp/stage/sbin
gcc fuse.c -Ofast -lfuse3 -w -o /tmp/stage/sbin/ul2fs
gcc main.c -Ofast -lfuse3 -w -o /tmp/stage/sbin/mkfs.ul2fs
cd $wd
yspm build --root /tmp/stage --output "$wd/ul2fs.yspkg" --name "ul2fs" --version "0.3.0" --abi yspm-abi-1 --arch x86_64
