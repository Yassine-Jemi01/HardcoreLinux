#!/bin/sh

wd=$(pwd)
cd $dir
rm -rf /tmp/stage
rm -rf build
mkdir build && cd build
meson setup .. --prefix=/usr --reconfigure
ninja
meson install --destdir=/tmp/stage
rm -r /tmp/stage/usr/share
find /tmp/stage -name '*.so*' -exec strip --strip-all {} \;
cd $wd
yspm build --root /tmp/stage --output "$wd/fcft.yspkg" --name "fcft" --version "3.3.3" --abi yspm-abi-1 --arch x86_64 --depends "pixman,libcairo_png,fontconfig,fribidi,harfbuzz"
