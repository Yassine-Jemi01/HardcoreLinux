#!/bin/sh

if [ "$1" = "help" ]; then
	printf '%s\n' "hardcore linux package manager (AKA flashman)"
	printf '%s\n' "install pkgdir" "installs a package archive (requires root)" ""
	printf '%s\n' "uninstall pkg" "uninstalls a package by name (requires root)" ""
	printf '%s\n' "info pkg" "shows package information"
	printf '%s\n' "list" "lists installed packages"
elif [ "$1" = "install" ]; then
	if command -v yspm >/dev/null 2>&1; then
		yspm install "$2"
		exit $?
	fi

	tar x -f "$2" -C /
	name=$(basename "${2%.*}")
	installer="/etc/installer/$name"
	if [ ! -d "$installer" ]; then
		printf 'flashman: package installer not found: %s\n' "$installer" >&2
		exit 1
	fi

	i=0
	errors=0
	printf '%s\n' "missing dependencies"
	for opt in $(cat "$installer/pkinfo"); do
		if [ "$i" -gt 1 ] && [ "$(ls /etc/installer | grep -c -w "$opt")" -eq 0 ]; then
			printf '%s\t' "$opt"
			errors=$((errors + 1))
		fi
		i=$((i + 1))
	done

	if [ "$errors" -gt 0 ]; then
		printf '%s\n' "aborting"
		sh "$installer/uninstall"
		exit 1
	fi

	sh "$installer/install"
elif [ "$1" = "uninstall" ]; then
	if command -v yspm >/dev/null 2>&1; then
		yspm remove "$2"
		exit $?
	fi

	sh "/etc/installer/$2/uninstall"
	rm -r "/etc/installer/$2"
elif [ "$1" = "info" ]; then
	if command -v yspm >/dev/null 2>&1; then
		yspm info "$2"
		exit $?
	fi

	name=$(basename "${2%.*}")
	cat "/etc/installer/$name/pkinfo"
elif [ "$1" = "list" ]; then
	if command -v yspm >/dev/null 2>&1; then
		yspm list
		exit $?
	fi

	ls /etc/installer
else
	printf '%s\n' "run flashman help"
fi
